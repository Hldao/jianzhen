<!-- 导航栏 -->
<view class="navbar" style="padding-top:{{statusBarHeight}}px;">
  <view class="navbar-inner" style="height:{{navBarHeight}}px;">
    <view class="nb-back" bindtap="goBack"><text class="nb-back-icon">‹</text></view>
    <text class="nb-title">我的报名</text>
    <view style="width:64rpx;"></view>
  </view>
</view>

<!-- Tab 栏 -->
<view class="me-tabs" style="top:calc({{statusBarHeight}}px + {{navBarHeight}}px);">
  <view class="me-tab {{activeTab==='active'?'mt-active':''}}" bindtap="switchTab" data-tab="active">进行中</view>
  <view class="me-tab {{activeTab==='ended'?'mt-active':''}}" bindtap="switchTab" data-tab="ended">已结束</view>
</view>

<scroll-view
  scroll-y enhanced show-scrollbar="{{false}}"
  class="scroll-body"
  style="top:calc({{statusBarHeight}}px + {{navBarHeight}}px + 88rpx);"
  bindscrolltolower="loadMore"
>
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="skeleton-list">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="ev-card">
      <view class="sk-img"></view>
      <view class="sk-lines">
        <view class="sk-line sk-line-a"></view>
        <view class="sk-line sk-line-b"></view>
        <view class="sk-line sk-line-c"></view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{list.length === 0}}" class="empty-state">
    <text class="es-icon">🏆</text>
    <text class="es-title">{{activeTab === 'active' ? '暂无进行中的报名' : '暂无已结束的报名'}}</text>
    <text class="es-desc">去赛事页面报名参赛吧</text>
    <view class="es-btn" bindtap="goEvents">浏览赛事</view>
  </view>

  <!-- 报名列表 -->
  <block wx:else>
    <view
      wx:for="{{list}}" wx:key="_id"
      class="ev-card"
      bindtap="tapEvent" data-id="{{item.eventId}}"
    >
      <view class="ev-card-top">
        <view class="ev-banner">
          <text class="ev-banner-emoji">🏹</text>
        </view>
        <view class="ev-card-info">
          <text class="ev-name">{{item.eventName}}</text>
          <text class="ev-org">{{item.organizer}}</text>
          <text class="ev-date">{{item.eventDate}}</text>
        </view>
      </view>
      <view class="ev-card-foot">
        <view class="ev-status ev-status-{{item.status}}">
          <text>{{item.statusLabel}}</text>
        </view>
        <text class="ev-regtime">报名于 {{item.regTimeLabel}}</text>
      </view>
    </view>
  </block>

  <view class="bottom-safe"></view>
</scroll-view>
