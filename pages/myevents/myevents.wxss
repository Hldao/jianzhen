page {
  background: #EEF1F8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --primary: #FF6B35;
  --text: #1A1A2E;
  --text-mid: #64748B;
  --text-light: #94A3B8;
  --border: #E8ECF2;
  --white: #fff;
  --shadow: 0 4rpx 20rpx rgba(0,0,0,.07);
  --radius: 28rpx;
}

/* ── 导航栏 ── */
.navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(255,255,255,.95);
  border-bottom: 1rpx solid var(--border);
}
.navbar-inner {
  display: flex; align-items: center;
  padding: 0 24rpx; position: relative;
}
.nb-back {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
}
.nb-back-icon { font-size: 48rpx; color: var(--text); line-height: 1; font-weight: 300; }
.nb-title { flex: 1; font-size: 32rpx; font-weight: 700; color: var(--text); text-align: center; }

/* ── Tab 栏 ── */
.me-tabs {
  position: fixed; left: 0; right: 0; z-index: 99;
  background: var(--white);
  display: flex; border-bottom: 1rpx solid var(--border);
  padding: 0 48rpx;
}
.me-tab {
  flex: 1; text-align: center;
  font-size: 26rpx; color: var(--text-light);
  padding: 20rpx 0 18rpx;
  position: relative;
}
.mt-active { color: var(--primary); font-weight: 700; }
.mt-active::after {
  content: ''; position: absolute; bottom: 0; left: 15%; right: 15%;
  height: 4rpx; background: var(--primary); border-radius: 4rpx;
}

/* ── 滚动体 ── */
.scroll-body {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 16rpx 24rpx 0;
  box-sizing: border-box;
}

/* ── 赛事卡片 ── */
.ev-card {
  background: var(--white); border-radius: var(--radius);
  overflow: hidden; margin-bottom: 16rpx;
  box-shadow: var(--shadow);
}
.ev-card-top { display: flex; gap: 20rpx; padding: 24rpx; }
.ev-banner {
  width: 100rpx; height: 100rpx; border-radius: 16rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #0F1F5C, #2563EB);
  display: flex; align-items: center; justify-content: center;
}
.ev-banner-emoji { font-size: 48rpx; line-height: 1; }
.ev-card-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; justify-content: center; }
.ev-name { font-size: 28rpx; font-weight: 700; color: var(--text); }
.ev-org  { font-size: 24rpx; color: var(--text-mid); }
.ev-date { font-size: 22rpx; color: var(--text-light); }

.ev-card-foot {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 24rpx; border-top: 1rpx solid var(--border);
}
.ev-status {
  font-size: 22rpx; font-weight: 700; padding: 6rpx 20rpx; border-radius: 20rpx;
}
.ev-status-pending  { background: rgba(245,158,11,.1); color: #F59E0B; }
.ev-status-approved { background: rgba(16,185,129,.1); color: #10B981; }
.ev-status-paid     { background: rgba(37,99,235,.1);  color: #2563EB; }
.ev-status-rejected { background: rgba(239,68,68,.1);  color: #EF4444; }
.ev-regtime { font-size: 22rpx; color: var(--text-light); }

/* ── 骨架屏 ── */
.skeleton-list {}
.sk-img   { width: 100rpx; height: 100rpx; border-radius: 16rpx; background: #E8ECF2; flex-shrink: 0; }
.sk-lines { flex: 1; }
.sk-line  { height: 22rpx; border-radius: 6rpx; background: #E8ECF2; margin-bottom: 14rpx; }
.sk-line-a { width: 50%; }
.sk-line-b { width: 70%; }
.sk-line-c { width: 35%; }

/* ── 空状态 ── */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 48rpx; gap: 16rpx;
}
.es-icon  { font-size: 80rpx; line-height: 1; }
.es-title { font-size: 30rpx; font-weight: 700; color: var(--text); }
.es-desc  { font-size: 24rpx; color: var(--text-light); text-align: center; }
.es-btn {
  margin-top: 8rpx; padding: 16rpx 48rpx; border-radius: 40rpx;
  background: var(--primary); color: #fff; font-size: 26rpx; font-weight: 700;
}

/* ── 底部安全 ── */
.bottom-safe { height: calc(40rpx + env(safe-area-inset-bottom)); }
