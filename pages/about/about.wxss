page {
  --primary: #FF6B35;
  --text: #1A1A2E;
  --text-mid: #64748B;
  --text-light: #94A3B8;
  --border: #E8ECF2;
  --white: #fff;
  --shadow: 0 4rpx 20rpx rgba(0,0,0,.07);
  --radius: 28rpx;
  background: #EEF1F8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}

/* ── 导航栏 ── */
.navbar {
  position: fixed; top: 0; left: 0; right: 0;
  background: #EEF1F8;
  z-index: 99;
}
.navbar-inner {
  position: relative;
  display: flex; align-items: center; justify-content: center;
  padding: 0 32rpx;
}
.nb-back {
  position: absolute; left: 16rpx; top: 50%;
  transform: translateY(-50%);
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
}
.nb-back-icon {
  font-size: 48rpx; color: var(--text); line-height: 1;
}
.nb-title {
  font-size: 32rpx; font-weight: 600; color: var(--text);
}

/* ── 滚动体 ── */
.page-body {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 32rpx;
}

/* ── Hero ── */
.hero {
  display: flex; flex-direction: column; align-items: center;
  padding: 64rpx 0 48rpx;
}

/* 同心环 logo */
.logo-ring {
  width: 160rpx; height: 160rpx; border-radius: 50%;
  background: #FFF5F0;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(255,107,53,.18);
}
.logo-ring-2 {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: #FFE3D1;
  display: flex; align-items: center; justify-content: center;
}
.logo-ring-3 {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: #FFB596;
  display: flex; align-items: center; justify-content: center;
}
.logo-dot {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: var(--primary);
  box-shadow: inset 0 0 0 4rpx rgba(255,255,255,.4);
}

.hero-title {
  font-size: 52rpx; font-weight: 700; color: var(--text);
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}
.hero-slogan {
  font-size: 26rpx; color: var(--text-mid);
  letter-spacing: 1rpx;
}
.hero-version {
  margin-top: 20rpx;
  padding: 6rpx 20rpx; border-radius: 24rpx;
  background: rgba(255,107,53,.08);
  font-size: 22rpx; color: var(--primary);
  font-weight: 500;
}

/* ── 卡片 ── */
.card {
  background: var(--white);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 32rpx;
  margin-bottom: 20rpx;
}
.card-title {
  display: block;
  font-size: 28rpx; font-weight: 700; color: var(--text);
  margin-bottom: 20rpx;
}
.card-text {
  display: block;
  font-size: 26rpx; color: var(--text-mid);
  line-height: 1.7;
  margin-bottom: 16rpx;
}
.card-text:last-of-type { margin-bottom: 0; }

/* ── 核心功能列表 ── */
.feat-row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 18rpx 0;
}
.feat-row:not(:last-child) {
  border-bottom: 1rpx solid var(--border);
}
.feat-icon {
  width: 80rpx; height: 80rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}
.feat-icon-orange { background: linear-gradient(135deg,#FFE3D1,#FFB596); }
.feat-icon-blue   { background: linear-gradient(135deg,#DBEAFE,#93C5FD); }
.feat-icon-green  { background: linear-gradient(135deg,#D1FAE5,#6EE7B7); }
.feat-icon-yellow { background: linear-gradient(135deg,#FEF3C7,#FCD34D); }
.feat-info {
  flex: 1; display: flex; flex-direction: column; gap: 6rpx;
  min-width: 0;
}
.feat-name { font-size: 28rpx; font-weight: 600; color: var(--text); }
.feat-desc { font-size: 22rpx; color: var(--text-mid); line-height: 1.5; }

/* ── 反馈 ── */
.contact-row {
  margin-top: 20rpx;
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx;
  background: #F8FAFC; border-radius: 20rpx;
}
.contact-icon {
  width: 72rpx; height: 72rpx; border-radius: 20rpx;
  background: linear-gradient(135deg,#FF6B35,#F59E0B);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.contact-info {
  flex: 1; display: flex; flex-direction: column; gap: 4rpx;
  min-width: 0;
}
.contact-label { font-size: 22rpx; color: var(--text-light); }
.contact-value {
  font-size: 28rpx; font-weight: 600; color: var(--text);
  font-family: 'SF Mono', Menlo, Consolas, monospace;
}
.contact-action {
  font-size: 24rpx; font-weight: 600; color: var(--primary);
  padding: 12rpx 24rpx; border-radius: 16rpx;
  background: rgba(255,107,53,.1);
  flex-shrink: 0;
}

/* ── 协议列表卡 ── */
.card-list { padding: 0 32rpx; }
.list-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx 0;
}
.list-row-label { font-size: 28rpx; color: var(--text); font-weight: 500; }
.list-row-arrow { font-size: 32rpx; color: var(--text-light); }

/* ── Footer ── */
.footer {
  margin-top: 40rpx;
  display: flex; flex-direction: column; align-items: center;
  gap: 8rpx;
}
.footer-line {
  font-size: 22rpx; color: var(--text-light);
  letter-spacing: 1rpx;
}
.footer-line-sub { font-size: 20rpx; opacity: 0.7; }

.bottom-safe { height: 120rpx; }
