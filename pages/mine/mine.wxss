page {
  background: #EEF1F8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --primary: #FF6B35;
  --text: #1A1A2E;
  --text-mid: #64748B;
  --text-light: #94A3B8;
  --border: #E8ECF2;
  --white: #fff;
  --shadow: 0 4rpx 20rpx rgba(0,0,0,.07);
  --radius: 28rpx;
}

/* ── 导航栏 ── */
.navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(255,255,255,.95);
  border-bottom: 1rpx solid var(--border);
}
.navbar-inner {
  display: flex; align-items: center;
  justify-content: center; padding: 0 24rpx; position: relative;
}
.nb-title { font-size: 32rpx; font-weight: 700; color: var(--text); }
.capsule-gap { position: absolute; right: 0; width: 190rpx; }

/* ── 滚动体 ── */
.scroll-body {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}

/* ── 个人信息头部卡 ── */
.profile-header {
  background: linear-gradient(145deg, #0F1F5C 0%, #1E3A8A 50%, #2563EB 100%);
  border-radius: var(--radius); padding: 36rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 16rpx 48rpx rgba(15,31,92,.35);
}
.profile-top {
  display: flex; align-items: center; gap: 24rpx; margin-bottom: 32rpx;
}
.profile-avatar {
  width: 96rpx; height: 96rpx; border-radius: 24rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #FF6B35, #FF8F5E);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,.4);
  overflow: hidden;
}
.profile-avatar-img { background: rgba(255,255,255,.15); }
.profile-meta { flex: 1; display: flex; flex-direction: column; gap: 10rpx; min-width: 0; }
.profile-name { font-size: 32rpx; font-weight: 800; color: #fff; }
.profile-level {
  display: inline-flex; align-items: center;
  background: rgba(255,107,53,.25); border: 1rpx solid rgba(255,107,53,.35);
  border-radius: 32rpx; padding: 4rpx 18rpx;
  font-size: 20rpx; color: #FFB347; font-weight: 600;
  align-self: flex-start;
}
.profile-edit-btn {
  padding: 10rpx 24rpx; border-radius: 32rpx;
  background: rgba(255,255,255,.15); flex-shrink: 0;
}
.peb-txt { font-size: 24rpx; color: rgba(255,255,255,.85); font-weight: 600; }
.profile-club-badge {
  display: inline-flex; align-items: center;
  background: rgba(255,255,255,.1);
  border-radius: 32rpx; padding: 4rpx 18rpx;
  font-size: 20rpx; color: rgba(255,255,255,.75);
  align-self: flex-start;
}

/* 统计数字行 */
.profile-stats {
  display: flex;
  background: rgba(255,255,255,.08); border-radius: 20rpx; overflow: hidden;
}
.ps-item {
  flex: 1; padding: 20rpx 12rpx; text-align: center;
  border-right: 1rpx solid rgba(255,255,255,.1);
}
.ps-item:last-child { border-right: none; }
.ps-num { display: block; font-size: 36rpx; font-weight: 800; color: #fff; line-height: 1; }
.ps-label { display: block; font-size: 20rpx; color: rgba(255,255,255,.55); margin-top: 6rpx; }

/* ── 成就徽章 ── */
.section-row {
  display: flex; align-items: center; justify-content: space-between;
  margin: 20rpx 4rpx 12rpx;
}
.section-label {
  font-size: 22rpx; font-weight: 700; color: var(--text-light);
  letter-spacing: 1rpx;
}
.section-toggle {
  display: flex; align-items: center; gap: 4rpx;
}
.st-txt { font-size: 22rpx; color: var(--text-light); }
.rot-90  { transform: rotate(90deg); }
.rot-270 { transform: rotate(270deg); }

/* 网格 */
.ach-grid {
  display: flex; flex-wrap: wrap; gap: 16rpx;
  margin-bottom: 16rpx;
}
.ach-grid-item {
  width: calc(25% - 12rpx);
  display: flex; flex-direction: column;
  align-items: center; gap: 10rpx;
}
.ach-icon {
  width: 96rpx; height: 96rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow);
}
.ach-name { font-size: 20rpx; color: var(--text-mid); text-align: center; }
.ach-name-locked { color: var(--text-light); }
.ach-sub  { font-size: 18rpx; color: var(--text-light); text-align: center; margin-top: -4rpx; }
.ach-icon-locked { opacity: .45; }

/* 成就详情弹窗 */
.ach-detail-mask {
  position: fixed; inset: 0; z-index: 200;
  background: rgba(0,0,0,.5);
  display: flex; align-items: flex-end; justify-content: center;
}
.ach-detail-card {
  width: 100%; background: var(--white);
  border-radius: 36rpx 36rpx 0 0;
  padding: 48rpx 40rpx calc(env(safe-area-inset-bottom) + 48rpx);
  display: flex; flex-direction: column; align-items: center;
  position: relative;
}
.adc-close {
  position: absolute; top: 28rpx; right: 36rpx;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: var(--border);
  display: flex; align-items: center; justify-content: center;
}
.adc-icon-wrap {
  width: 128rpx; height: 128rpx; border-radius: 32rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,.12);
  margin-bottom: 24rpx;
}
.adc-name {
  font-size: 36rpx; font-weight: 800; color: var(--text);
  margin-bottom: 12rpx;
}
.adc-desc {
  font-size: 26rpx; color: var(--text-mid); text-align: center;
  line-height: 1.6; margin-bottom: 32rpx; padding: 0 20rpx;
}
.adc-divider {
  width: 100%; height: 1rpx; background: var(--border); margin-bottom: 28rpx;
}
.adc-status {
  display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx;
}
.adc-status-dot {
  width: 20rpx; height: 20rpx; border-radius: 50%; flex-shrink: 0;
}
.adc-dot-green { background: #10B981; }
.adc-status-txt { font-size: 28rpx; color: var(--text-mid); }
.adc-status-locked { color: var(--text-light); }
.adc-count-badge {
  background: rgba(255,107,53,.1); border-radius: 20rpx;
  padding: 8rpx 28rpx; margin-bottom: 16rpx;
  font-size: 24rpx; font-weight: 700; color: var(--primary);
}
.adc-progress {
  background: var(--border); border-radius: 16rpx;
  padding: 12rpx 28rpx; margin-top: 8rpx;
}
.adc-progress-txt { font-size: 24rpx; color: var(--text-mid); }

/* ── 功能菜单 ── */
.menu-list {
  background: var(--white); border-radius: var(--radius);
  overflow: hidden; box-shadow: var(--shadow);
  margin-bottom: 16rpx; padding: 0 28rpx;
}
.menu-item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 30rpx 0;
}
.menu-item-share { position: relative; }
.share-overlay-btn {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  margin: 0; padding: 0;
  background: transparent; opacity: 0;
  border: none; line-height: 1;
}
.share-overlay-btn::after { border: none; }
.menu-divider { height: 1rpx; background: var(--border); }
.menu-icon {
  width: 64rpx; height: 64rpx; border-radius: 16rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.menu-label { flex: 1; font-size: 28rpx; font-weight: 500; color: var(--text); }
.menu-item-inner { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.menu-item-inner .menu-label { flex: none; }
.menu-sub-label { font-size: 22rpx; color: var(--text-light); }
.menu-badge {
  font-size: 20rpx; font-weight: 700; color: var(--primary);
  background: rgba(255,107,53,.1);
  border-radius: 20rpx; padding: 4rpx 16rpx; margin-right: 4rpx;
}
.menu-badge-red { background: rgba(239,68,68,.1); color: #EF4444; }

/* ── 底部安全距离 ── */
.bottom-safe { height: calc(100rpx + env(safe-area-inset-bottom) + 32rpx); }
