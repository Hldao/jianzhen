page {
  background: #EEF1F8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --primary: #FF6B35;
  --text: #1A1A2E;
  --text-mid: #64748B;
  --text-light: #94A3B8;
  --border: #E8ECF2;
  --shadow: 0 4rpx 20rpx rgba(0,0,0,.07);
  --radius: 28rpx;
}

/* ── 导航栏 ── */
.navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(255,255,255,.95); backdrop-filter: blur(10px);
  border-bottom: 1rpx solid var(--border);
}
.navbar-inner {
  display: flex; align-items: center;
  justify-content: space-between; padding: 0 24rpx;
}
.nb-back {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: flex-start;
}
.nb-back .lc { width: 40rpx; height: 40rpx; }
.nb-title { font-size: 32rpx; font-weight: 700; color: var(--text); }

/* ── 滚动体 ── */
.scroll-body {
  position: fixed; left: 0; right: 0; bottom: 0;
  box-sizing: border-box;
}

/* ── 封面 ── */
.pub-cover {
  background: linear-gradient(145deg, #0F1F5C, #1E3A8A, #2563EB);
  padding: 48rpx 32rpx 40rpx;
  position: relative; overflow: hidden;
}
.pub-cover-deco {
  position: absolute; right: -60rpx; top: -60rpx;
  width: 240rpx; height: 240rpx; border-radius: 50%;
  background: rgba(255,255,255,.05);
  pointer-events: none;
}
.pub-name {
  font-size: 36rpx; font-weight: 800; color: #fff; margin-bottom: 10rpx;
}
.pub-badge-row { margin-bottom: 28rpx; }
.pub-badge {
  display: inline-flex; align-items: center; gap: 8rpx;
  background: rgba(52,211,153,.2); border: 1rpx solid rgba(52,211,153,.3);
  border-radius: 40rpx; padding: 6rpx 20rpx;
  font-size: 22rpx; color: #34D399; font-weight: 600;
}
.pub-stats-row {
  display: flex; background: rgba(255,255,255,.1);
  border-radius: 24rpx; overflow: hidden;
}
.pub-stat {
  flex: 1; padding: 24rpx 16rpx; text-align: center;
}
.pub-stat-vline { width: 1rpx; background: rgba(255,255,255,.12); }
.pub-stat-num { display: block; font-size: 40rpx; font-weight: 800; color: #fff; line-height: 1; }
.pub-stat-lbl { display: block; font-size: 20rpx; color: rgba(255,255,255,.5); margin-top: 6rpx; }

/* ── 菜单 ── */
.pub-menu { padding: 24rpx; display: flex; flex-direction: column; gap: 20rpx; }
.pub-menu-item {
  display: flex; align-items: center; gap: 24rpx;
  background: #fff; border-radius: var(--radius); padding: 32rpx;
  box-shadow: var(--shadow);
}
.pub-menu-icon {
  width: 88rpx; height: 88rpx; border-radius: 24rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.pub-icon-orange { background: rgba(255,107,53,.1); }
.pub-icon-blue   { background: rgba(37,99,235,.1); }
.pub-icon-green  { background: rgba(16,185,129,.1); }
.pub-menu-icon .lc { width: 44rpx; height: 44rpx; }
.pub-menu-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.pub-menu-label { font-size: 30rpx; font-weight: 700; color: var(--text); }
.pub-menu-sub { font-size: 22rpx; color: var(--text-light); }
.pub-menu-item .lc-chevron-right { width: 28rpx; height: 28rpx; }
.pub-pending-badge {
  font-size: 20rpx; font-weight: 700;
  background: rgba(245,158,11,.1); color: #F59E0B;
  border-radius: 20rpx; padding: 6rpx 18rpx; margin-right: 8rpx;
}

/* ── 底部安全 ── */
.bottom-safe { height: calc(40rpx + env(safe-area-inset-bottom)); }
