page {
  background: #EEF1F8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --primary: #FF6B35;
  --text: #1A1A2E;
  --text-mid: #64748B;
  --text-light: #94A3B8;
  --border: #E8ECF2;
  --white: #fff;
  --shadow: 0 4rpx 20rpx rgba(0,0,0,.07);
  --radius: 28rpx;
}

/* ── 导航栏 ── */
.navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(255,255,255,.95);
  border-bottom: 1rpx solid var(--border);
}
.navbar-inner {
  display: flex; align-items: center;
  padding: 0 24rpx;
}
.nb-back {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: flex-start;
  padding-left: 4rpx;
}
/* CSS 画的左箭头，所有微信版本均兼容 */
.nb-back-arrow {
  width: 20rpx; height: 20rpx;
  border-left: 4rpx solid var(--text);
  border-bottom: 4rpx solid var(--text);
  transform: rotate(45deg);
  margin-left: 10rpx;
}
.nb-title {
  flex: 1; text-align: center;
  font-size: 32rpx; font-weight: 700; color: var(--text);
}
.nb-right { width: 64rpx; }

/* ── 滚动体 ── */
.scroll-body {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}

/* ── 底部安全区 ── */
.bottom-safe {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ── 加载中 ── */
.loading-wrap {
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 0; gap: 24rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-spinner {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  border: 6rpx solid #E8ECF2; border-top-color: var(--primary);
  animation: spin .8s linear infinite;
}
.loading-txt { font-size: 26rpx; color: var(--text-light); }

/* ── 空状态 ── */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 48rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-title { font-size: 32rpx; font-weight: 700; color: var(--text); margin-bottom: 12rpx; }
.empty-sub { font-size: 26rpx; color: var(--text-light); margin-bottom: 40rpx; }
.btn-go-train {
  background: var(--primary); color: #fff; border: none;
  border-radius: 48rpx; padding: 0 56rpx;
  height: 88rpx; line-height: 88rpx;
  font-size: 30rpx; font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,.32);
}
.btn-go-train::after { border: none; }

/* ── 累计概览卡 ── */
.summary-card {
  background: linear-gradient(145deg, #0F1F5C 0%, #1E3A8A 50%, #2563EB 100%);
  border-radius: var(--radius); padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 48rpx rgba(15,31,92,.35);
  display: flex; align-items: center;
}
.sc-stat {
  flex: 1; display: flex; flex-direction: column; align-items: center;
}
.sc-num {
  font-size: 48rpx; font-weight: 900; color: #fff;
  line-height: 1; letter-spacing: -2rpx;
  margin-bottom: 10rpx;
}
.sc-lbl { font-size: 20rpx; color: rgba(255,255,255,.5); text-align: center; }
.sc-vline { width: 1rpx; height: 52rpx; background: rgba(255,255,255,.15); }

/* ── 趋势图卡 ── */
.chart-card {
  background: var(--white); border-radius: var(--radius);
  padding: 24rpx; margin-bottom: 20rpx; box-shadow: var(--shadow);
}
.chart-hd {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
}
.chart-title { font-size: 28rpx; font-weight: 700; color: var(--text); }
.chart-metric-tabs { display: flex; background: var(--border); border-radius: 20rpx; overflow: hidden; }
.cmt {
  font-size: 20rpx; font-weight: 600; color: var(--text-light);
  padding: 6rpx 20rpx;
}
.cmt-on { background: var(--primary); color: #fff; border-radius: 20rpx; }
.chart-range-tabs { display: flex; margin-bottom: 16rpx; }
.crt {
  font-size: 22rpx; color: var(--text-light); font-weight: 600;
  padding: 6rpx 20rpx; border-radius: 20rpx; margin-right: 8rpx;
}
.crt-on { background: rgba(37,99,235,.1); color: #2563EB; }
.trend-canvas { width: 100%; height: 200rpx; display: block; }
.chart-empty {
  height: 200rpx; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: var(--text-light);
}
.chart-trend {
  margin-top: 16rpx; padding: 16rpx 20rpx;
  background: rgba(255,107,53,.06); border-radius: 16rpx;
  font-size: 24rpx; color: var(--text-mid); line-height: 1.6;
}
.chart-legend {
  display: flex; align-items: center; margin-top: 16rpx; flex-wrap: wrap;
}
.cl-item { display: flex; align-items: center; margin-right: 24rpx; margin-top: 8rpx; }
.cl-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 8rpx; }
.cl-txt { font-size: 20rpx; color: var(--text-light); }
.cl-item-ma .cl-ma-line {
  width: 28rpx; height: 3rpx; border-radius: 2rpx;
  background: rgba(37,99,235,.45); margin-right: 8rpx;
}

/* ── 记录卡 ── */
.record-card {
  background: var(--white); border-radius: var(--radius);
  padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

.rc-divider {
  height: 1rpx; background: var(--border); margin: 20rpx 0;
}

/* 日期行 */
.rc-header {
  display: flex; justify-content: space-between; align-items: center;
}
.rc-date { font-size: 28rpx; font-weight: 700; color: var(--text); }
.rc-time { font-size: 26rpx; color: var(--text-light); }

/* 标签行 */
.rc-tags { display: flex; flex-wrap: wrap; }
.rc-tag {
  font-size: 22rpx; font-weight: 600;
  color: var(--text-mid); background: #F1F5F9;
  border-radius: 30rpx; padding: 6rpx 18rpx;
  margin-right: 12rpx; margin-bottom: 0rpx;
}
.rc-tag-mode {
  color: var(--primary); background: rgba(255,107,53,.08);
  margin-right: 0;
}

/* 核心数据 */
.rc-stats { display: flex; align-items: center; }
.rc-stat {
  flex: 1; display: flex; flex-direction: column; align-items: center;
}
.rc-stat-num {
  font-size: 52rpx; font-weight: 900; color: var(--text);
  line-height: 1; letter-spacing: -2rpx;
  margin-bottom: 10rpx;
}
.rc-stat-lbl { font-size: 20rpx; color: var(--text-light); text-align: center; }
.rc-stat-vline { width: 1rpx; height: 56rpx; background: var(--border); }

/* 备注 — 不用 italic，微信对中文无效 */
.rc-note {
  display: flex; align-items: flex-start;
  background: rgba(255,107,53,.05);
  border-left: 6rpx solid rgba(255,107,53,.25);
  border-radius: 0 12rpx 12rpx 0;
  padding: 16rpx 20rpx;
  margin-top: -4rpx; margin-bottom: 20rpx;
}
.rc-note-icon { font-size: 24rpx; margin-right: 10rpx; flex-shrink: 0; }
.rc-note-txt {
  font-size: 24rpx; color: var(--text-mid); line-height: 1.6;
}

/* 底部提示行 */
.rc-footer {
  display: flex; justify-content: space-between; align-items: center;
}
.rc-arrows-hint { font-size: 24rpx; color: var(--text-light); }
.rc-chevron { font-size: 28rpx; color: var(--text-light); }

/* 点击态 */
.record-card-pressed { opacity: 0.82; }
