page {
  background: #EEF1F8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --primary: #FF6B35;
  --text: #1A1A2E;
  --text-mid: #64748B;
  --text-light: #94A3B8;
  --border: #E8ECF2;
  --shadow: 0 4rpx 20rpx rgba(0,0,0,.07);
  --radius: 28rpx;
}

/* ── 导航栏 ── */
.navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(255,255,255,.95); backdrop-filter: blur(10px);
  border-bottom: 1rpx solid var(--border);
}
.navbar-inner {
  display: flex; align-items: center;
  justify-content: space-between; padding: 0 24rpx;
}
.nb-back {
  width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: flex-start;
}
.nb-back .lc { width: 40rpx; height: 40rpx; }
.nb-title { font-size: 32rpx; font-weight: 700; color: var(--text); }

/* ── 滚动体 ── */
.scroll-body {
  position: fixed; left: 0; right: 0; bottom: 0;
  box-sizing: border-box;
}

/* ── 表单主体 ── */
.form-body { padding: 24rpx 24rpx 160rpx; }

/* ── 分组标题 ── */
.section-title {
  font-size: 22rpx; font-weight: 700; color: var(--text-light);
  letter-spacing: 1rpx; text-transform: uppercase;
  padding: 0 4rpx; margin: 32rpx 0 16rpx;
}
.section-title:first-child { margin-top: 0; }

/* ── 字段组 ── */
.field-group {
  background: #fff; border-radius: var(--radius);
  box-shadow: var(--shadow); overflow: hidden;
}
.field { padding: 26rpx 28rpx; }
.field-row {
  display: flex; gap: 0;
}
.field-half { flex: 1; padding: 26rpx 28rpx; }
.field-half:first-child { border-right: 1rpx solid var(--border); }
.field-divider { height: 1rpx; background: var(--border); margin: 0 28rpx; }
.field-label {
  display: block; font-size: 24rpx; font-weight: 600; color: var(--text-mid);
  margin-bottom: 14rpx;
}
.required { color: #EF4444; }

/* ── 输入框 ── */
.field-input {
  width: 100%; font-size: 28rpx; color: var(--text);
  background: none; border: none;
}
.field-input-row { display: flex; align-items: center; gap: 12rpx; }
.field-input-fee { flex: 1; }
.field-unit { font-size: 26rpx; color: var(--text-mid); flex-shrink: 0; }
.field-textarea {
  width: 100%; font-size: 28rpx; color: var(--text);
  background: none; border: none; line-height: 1.6;
  min-height: 80rpx;
}

/* ── 日期选择器 ── */
.field-picker {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0;
}
.picker-val { font-size: 28rpx; color: var(--text); }
.picker-placeholder { font-size: 28rpx; color: #94A3B8; }
.field-picker .lc { width: 28rpx; height: 28rpx; }

/* ── 上传区域 ── */
.upload-area {
  display: flex; flex-direction: column; align-items: center;
  gap: 12rpx; padding: 40rpx 0;
  border: 2rpx dashed var(--border); border-radius: 16rpx;
  background: #FAFBFC;
}
.upload-area-sm { padding: 28rpx 0; }
.upload-area .lc { width: 56rpx; height: 56rpx; }
.upload-label { font-size: 26rpx; font-weight: 600; color: var(--text-mid); }
.upload-sub { font-size: 22rpx; color: var(--text-light); }
.upload-preview { width: 100%; position: relative; }
.cover-img { width: 100%; height: 200rpx; border-radius: 14rpx; display: block; }
.cover-change {
  position: absolute; bottom: 16rpx; right: 16rpx;
  font-size: 22rpx; color: #fff; background: rgba(0,0,0,.45);
  border-radius: 12rpx; padding: 8rpx 20rpx;
}

/* ── 竞赛项目 chips ── */
.cat-chips { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 28rpx; }
.cat-chip {
  font-size: 26rpx; font-weight: 600; color: var(--text-mid);
  background: #F1F4F9; border-radius: 48rpx; padding: 14rpx 28rpx;
  border: 2rpx solid transparent;
}
.cat-chip-on {
  color: var(--primary); background: rgba(255,107,53,.08);
  border-color: rgba(255,107,53,.3);
}

/* ── 底部提交栏 ── */
.submit-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(255,255,255,.95); backdrop-filter: blur(10px);
  border-top: 1rpx solid var(--border);
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}
.submit-btn {
  width: 100%; height: 96rpx; border-radius: var(--radius);
  background: linear-gradient(135deg, #FF6B35, #FF8F5E); color: #fff;
  font-size: 32rpx; font-weight: 700; border: none; margin: 0;
  box-shadow: 0 12rpx 32rpx rgba(255,107,53,.38);
}
.submit-btn::after { border: none; }

/* ── 底部安全 ── */
.bottom-safe { height: calc(40rpx + env(safe-area-inset-bottom)); }
