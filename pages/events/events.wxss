page {
  background: #EEF1F8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --primary: #FF6B35;
  --text: #1A1A2E;
  --text-mid: #64748B;
  --text-light: #94A3B8;
  --border: #E8ECF2;
  --white: #fff;
  --shadow: 0 4rpx 20rpx rgba(0,0,0,.07);
  --radius: 28rpx;
}

/* ── 导航栏 ── */
.navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(255,255,255,.95);
  border-bottom: 1rpx solid var(--border);
}
.navbar-inner {
  display: flex; align-items: center;
  justify-content: center; padding: 0 24rpx; position: relative;
}
.nb-title { font-size: 32rpx; font-weight: 700; color: var(--text); }
.capsule-gap { position: absolute; right: 0; width: 190rpx; }

/* ── 滚动体 ── */
.scroll-body {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}

/* ── 精选赛事卡 ── */
.featured-card {
  background: linear-gradient(145deg, #0F1F5C 0%, #1E3A8A 50%, #2563EB 100%);
  border-radius: var(--radius); padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 48rpx rgba(15,31,92,.35);
}
.fc-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 20rpx;
}
.fc-badge {
  font-size: 20rpx; font-weight: 700; color: #FFD700;
  background: rgba(255,215,0,.15); border-radius: 8rpx; padding: 4rpx 14rpx;
  letter-spacing: 1rpx;
}
.fc-status-open {
  font-size: 22rpx; font-weight: 600; color: #4ADE80;
}
.fc-name {
  font-size: 34rpx; font-weight: 900; color: #fff;
  margin-bottom: 12rpx; line-height: 1.3;
}
.fc-meta {
  display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 24rpx;
}
.fc-meta-row {
  display: flex; align-items: center; gap: 12rpx;
}
.fc-meta-icon { font-size: 22rpx; }
.fc-meta-txt { font-size: 24rpx; color: rgba(255,255,255,.75); }
.fc-footer {
  display: flex; justify-content: space-between; align-items: center;
}
.fc-count {
  font-size: 22rpx; color: rgba(255,255,255,.55);
}
.fc-count-num { font-size: 32rpx; font-weight: 800; color: #fff; }
.fc-btn {
  font-size: 26rpx; font-weight: 700; color: #fff;
  background: rgba(255,255,255,.18); border-radius: 48rpx;
  padding: 12rpx 32rpx;
}

/* ── 排序栏 ── */
.sort-bar {
  display: flex; gap: 16rpx; margin-bottom: 16rpx;
}
.sort-chip {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx;
  padding: 16rpx 0; border-radius: 48rpx;
  font-size: 26rpx; font-weight: 600;
  background: var(--white); color: var(--text-mid);
  box-shadow: var(--shadow);
  transition: all .2s;
}
.sort-chip-active {
  background: var(--primary); color: #fff;
}
.sort-chip-icon { font-size: 24rpx; }

/* ── 赛事列表卡 ── */
.comp-list-card {
  background: var(--white); border-radius: var(--radius);
  padding: 8rpx 28rpx; margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}
.comp-item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 24rpx 0; border-bottom: 1rpx solid var(--border);
}
.comp-item-last { border-bottom: none; }

/* 日期块 */
.comp-date {
  display: flex; flex-direction: column; align-items: center;
  width: 68rpx; flex-shrink: 0;
}
.comp-date-day { font-size: 44rpx; font-weight: 900; color: var(--text); line-height: 1; }
.comp-date-month { font-size: 20rpx; color: var(--text-light); margin-top: 4rpx; }

/* 赛事信息 */
.comp-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.comp-name { font-size: 28rpx; font-weight: 700; color: var(--text); }
.comp-meta { font-size: 22rpx; color: var(--text-light); }

/* 右侧 */
.comp-right { display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; flex-shrink: 0; }
.comp-dist {
  font-size: 22rpx; font-weight: 600; color: var(--text-mid);
}
.status-badge {
  font-size: 20rpx; font-weight: 600; padding: 4rpx 14rpx; border-radius: 8rpx;
}
.status-open { color: #16A34A; background: rgba(22,163,74,.1); }
.status-soon { color: #D97706; background: rgba(217,119,6,.1); }
.status-full { color: #94A3B8; background: rgba(148,163,184,.1); }

/* 已报名小标记 */
.comp-myreg {
  font-size: 20rpx; font-weight: 700; color: #2563EB;
  background: rgba(37,99,235,.1); border-radius: 8rpx;
  padding: 4rpx 10rpx;
}

/* 精选卡的各状态文字颜色 */
.fc-status-open { font-size: 22rpx; font-weight: 600; color: #4ADE80; }
.fc-status-soon { font-size: 22rpx; font-weight: 600; color: #FCD34D; }
.fc-status-full { font-size: 22rpx; font-weight: 600; color: rgba(255,255,255,.5); }

/* ── 骨架屏 ── */
.sk-featured { opacity: .5; pointer-events: none; }
.sk-chip { height: 72rpx; background: #E8ECF2; border-radius: 48rpx; }
.sk-date-block { width: 68rpx; height: 68rpx; border-radius: 12rpx; background: #E8ECF2; flex-shrink: 0; }
.sk-info { flex: 1; }
.sk-status-block { width: 80rpx; height: 40rpx; border-radius: 8rpx; background: #E8ECF2; }
.sk-line { border-radius: 8rpx; background: #E8ECF2; margin-bottom: 16rpx; }
.sk-line-sm { width: 35%; height: 24rpx; }
.sk-line-md { width: 60%; height: 28rpx; }
.sk-line-lg { width: 85%; height: 36rpx; }

/* ── 空状态 ── */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 48rpx; gap: 16rpx;
}
.es-icon  { font-size: 80rpx; line-height: 1; }
.es-title { font-size: 30rpx; font-weight: 700; color: #1A1A2E; }
.es-desc  { font-size: 24rpx; color: #94A3B8; text-align: center; line-height: 1.7; }
.empty-sub { padding: 32rpx; text-align: center; }
.empty-sub-txt { font-size: 24rpx; color: #94A3B8; }

/* ── 搜索栏 ── */
.ev-search-bar {
  display: flex; align-items: center; gap: 16rpx;
  background: #fff; border-radius: 24rpx; padding: 18rpx 24rpx;
  margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.06);
}
.ev-search-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.ev-search-input { flex: 1; font-size: 28rpx; color: #1A1A2E; background: none; border: none; }
.ev-search-clear {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #E8ECF2; display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.ev-search-clear .lc { width: 20rpx; height: 20rpx; }

/* ── 底部安全 ── */
.bottom-safe { height: calc(40rpx + env(safe-area-inset-bottom)); }
