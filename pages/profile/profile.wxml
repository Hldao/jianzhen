<!-- 导航栏 -->
<view class="navbar" style="padding-top:{{statusBarHeight}}px;">
  <view class="navbar-inner" style="height:{{navBarHeight}}px;">
    <view class="nb-back" bindtap="goBack"><text class="nb-back-icon">‹</text></view>
    <text class="nb-title">个人资料</text>
    <view style="width:64rpx;"></view>
  </view>
</view>

<scroll-view
  scroll-y enhanced show-scrollbar="{{false}}"
  class="scroll-body"
  style="top:calc({{statusBarHeight}}px + {{navBarHeight}}px);"
>

  <!-- 头像（微信原生选取） -->
  <view class="pf-avatar-wrap">
    <button class="pf-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="pf-avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="pf-avatar">
        <text class="pf-avatar-emoji">🏹</text>
      </view>
      <view class="pf-avatar-edit-dot"></view>
    </button>
    <text class="pf-avatar-hint">{{avatarUrl ? '点击更换' : '点击使用微信头像'}}</text>
  </view>

  <!-- 昵称（微信原生昵称选择器） -->
  <view class="pf-card">
    <view class="pf-field">
      <text class="pf-label">昵称</text>
      <input
        class="pf-input"
        type="nickname"
        placeholder="点击填入微信昵称"
        value="{{nickName}}"
        maxlength="16"
        bindinput="onNicknameInput"
        bindblur="onNicknameInput"
      />
    </view>

    <view class="pf-divider"></view>

    <!-- 所在城市 -->
    <view class="pf-field">
      <text class="pf-label">所在城市</text>
      <input
        class="pf-input"
        type="text"
        placeholder="如：北京、上海…"
        value="{{city}}"
        maxlength="20"
        bindinput="inputCity"
      />
    </view>
  </view>

  <!-- 弓种 -->
  <view class="pf-card">
    <text class="pf-section-title">弓种</text>
    <view class="chips">
      <view
        wx:for="{{bowOptions}}" wx:key="*this"
        class="chip {{bowType === item ? 'chip-on' : ''}}"
        bindtap="pickBow" data-val="{{item}}"
      >{{item}}</view>
    </view>
  </view>

  <!-- 常训距离 -->
  <view class="pf-card">
    <text class="pf-section-title">常训距离</text>
    <view class="chips">
      <view
        wx:for="{{distOptions}}" wx:key="*this"
        class="chip {{trainDist === item ? 'chip-on' : ''}}"
        bindtap="pickDist" data-val="{{item}}"
      >{{item}}</view>
    </view>
  </view>

  <!-- 所属俱乐部 -->
  <view class="pf-card">
    <view class="pf-field pf-field-row" bindtap="openClubPicker">
      <text class="pf-label">所属俱乐部</text>
      <view class="pf-selector">
        <text class="{{club ? 'pf-selector-val' : 'pf-selector-ph'}}">{{club || '选择你的俱乐部'}}</text>
        <view wx:if="{{club}}" class="pf-clear-btn" catchtap="clearClub">
          <view class="lc lc-xs lc-gray lc-x"></view>
        </view>
        <text wx:else class="pf-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="bottom-safe"></view>
</scroll-view>

<!-- 保存按钮 -->
<view class="submit-bar" style="padding-bottom:calc({{safeBottom}}px + 24rpx);">
  <view class="submit-btn" bindtap="saveProfile">保存资料</view>
</view>

<!-- 俱乐部底部面板 -->
<view wx:if="{{showClubSheet}}" class="sheet-mask" bindtap="closeClubPicker"></view>
<view class="club-sheet {{showClubSheet ? 'club-sheet-open' : ''}}">
  <view class="club-sheet-handle"></view>
  <view class="club-sheet-hd">
    <text class="club-sheet-title">选择俱乐部</text>
    <view class="club-sheet-actions">
      <view class="club-sheet-add" bindtap="openCreateClub"><text class="csa-icon">+</text></view>
      <view class="club-sheet-close" bindtap="closeClubPicker"><text class="csc-x">✕</text></view>
    </view>
  </view>
  <view class="club-search-bar">
    <input
      class="club-search-input"
      placeholder="搜索俱乐部名称"
      value="{{clubKeyword}}"
      bindinput="searchClub"
    />
  </view>
  <scroll-view scroll-y class="club-list" style="max-height:500rpx;">
    <view
      wx:for="{{filteredClubs}}" wx:key="_id"
      class="club-list-item {{club === item.name ? 'club-item-sel' : ''}}"
      bindtap="selectClub" data-name="{{item.name}}" data-id="{{item._id}}"
    >
      <view class="cli-main">
        <text class="cli-name">{{item.name}}</text>
        <text wx:if="{{item.city}}" class="cli-city">{{item.city}}</text>
      </view>
      <view class="cli-right">
        <text class="cli-count">{{item.memberCount || 0}} 人</text>
        <view wx:if="{{club === item.name}}" class="cli-joined-badge">已加入</view>
      </view>
    </view>
    <view wx:if="{{!filteredClubs.length}}" class="club-empty">
      <text class="club-empty-txt">{{clubKeyword ? '未找到 "' + clubKeyword + '" 相关俱乐部' : '暂无俱乐部'}}</text>
      <view class="club-empty-cta" bindtap="openCreateClub">＋ 创建新俱乐部</view>
    </view>
  </scroll-view>
</view>

<!-- 创建俱乐部弹层 -->
<view wx:if="{{showCreateClub}}" class="cc-mask" catchtap="closeCreateClub">
  <view class="cc-card" catchtap="">
    <text class="cc-title">创建俱乐部</text>
    <text class="cc-sub">向社区添加你的俱乐部，方便箭友找到</text>

    <view class="cc-field">
      <text class="cc-label">俱乐部名称<text class="cc-required">*</text></text>
      <input
        class="cc-input"
        placeholder="2-30 字"
        maxlength="30"
        value="{{newClubName}}"
        bindinput="inputNewClubName"
        focus="{{showCreateClub}}"
        adjust-position="{{false}}"
      />
    </view>

    <view class="cc-field">
      <text class="cc-label">所在城市<text class="cc-opt"> · 选填</text></text>
      <input
        class="cc-input"
        placeholder="如：北京、上海"
        maxlength="20"
        value="{{newClubCity}}"
        bindinput="inputNewClubCity"
      />
    </view>

    <view class="cc-btns">
      <view class="cc-btn cc-btn-cancel" bindtap="closeCreateClub">取消</view>
      <view
        class="cc-btn cc-btn-create {{creatingClub ? 'cc-btn-loading' : ''}}"
        bindtap="submitCreateClub"
      >{{creatingClub ? '创建中…' : '创建'}}</view>
    </view>
  </view>
</view>
