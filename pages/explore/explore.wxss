page {
  background: #EEF1F8;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  --primary: #FF6B35;
  --text: #1A1A2E;
  --text-mid: #64748B;
  --text-light: #94A3B8;
  --border: #E8ECF2;
  --white: #fff;
  --shadow: 0 4rpx 20rpx rgba(0,0,0,.07);
  --radius: 28rpx;
}

/* ── 导航栏 ─────────────────────────────────────── */
.navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: rgba(255,255,255,.95);
  border-bottom: 1rpx solid var(--border);
}
.navbar-inner {
  display: flex; align-items: center;
  justify-content: space-between; padding: 0 24rpx;
  position: relative;
}
.nb-back {
  width: 80rpx; display: flex; align-items: center;
  cursor: pointer;
}
.nb-back-icon {
  font-size: 52rpx; color: var(--text); font-weight: 300; line-height: 1;
}
.nb-title {
  position: absolute; left: 0; right: 0;
  text-align: center; pointer-events: none;
  font-size: 34rpx; font-weight: 800; color: var(--text);
}
.nb-right { width: 80rpx; }

/* ── 页面主体 ───────────────────────────────────── */
.page-content {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}

/* ── Tab 切换 ────────────────────────────────────── */
.tab-switch {
  display: flex; align-items: center;
  background: var(--white); border-radius: 20rpx;
  padding: 8rpx; margin-bottom: 20rpx;
  box-shadow: var(--shadow);
  position: relative;
}
.ts-item {
  flex: 1; text-align: center; padding: 16rpx 0;
  font-size: 28rpx; font-weight: 600; color: var(--text-light);
  border-radius: 14rpx; z-index: 1; position: relative;
  transition: color .25s;
}
.ts-active { color: var(--primary); }
.ts-indicator {
  position: absolute; left: 8rpx; top: 8rpx; bottom: 8rpx;
  width: calc(50% - 8rpx);
  background: rgba(255,107,53,.1); border-radius: 14rpx;
  transition: left .25s cubic-bezier(.4,0,.2,1);
}
.ts-indicator-right { left: calc(50%); }

/* ── 通用卡片 ───────────────────────────────────── */
.section-card {
  background: var(--white); border-radius: var(--radius);
  padding: 28rpx; margin-bottom: 20rpx; box-shadow: var(--shadow);
}
.section-hd {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 20rpx;
}
.section-title { font-size: 28rpx; font-weight: 700; color: var(--text); }
.section-sub   { font-size: 22rpx; color: var(--text-light); }

/* ── 用户行 ─────────────────────────────────────── */
.user-row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 0; border-bottom: 1rpx solid var(--border);
}
.user-row:last-child { border-bottom: none; padding-bottom: 0; }
.user-avatar-img {
  width: 80rpx; height: 80rpx; border-radius: 20rpx; flex-shrink: 0; object-fit: cover;
}
.user-avatar-txt {
  width: 80rpx; height: 80rpx; border-radius: 20rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #0F1F5C, #2563EB);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 700; color: #fff;
}
.user-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.user-name { font-size: 28rpx; font-weight: 600; color: var(--text); }
.user-sub  { font-size: 22rpx; color: var(--text-light); }

/* ── 成绩徽章 ───────────────────────────────────── */
.score-badge { display: flex; align-items: baseline; gap: 2rpx; flex-shrink: 0; }
.score-num { font-size: 36rpx; font-weight: 900; color: var(--primary); line-height: 1; }
.score-unit { font-size: 20rpx; color: var(--text-light); }

/* ── 俱乐部加入按钮 ─────────────────────────────── */
.join-btn {
  padding: 12rpx 28rpx; border-radius: 48rpx;
  background: var(--primary); color: #fff;
  font-size: 24rpx; font-weight: 700; flex-shrink: 0;
}
.join-btn-done {
  background: rgba(255,107,53,.1); color: var(--primary);
}

/* ── 搜索框 ─────────────────────────────────────── */
.search-bar {
  display: flex; align-items: center; gap: 12rpx;
  background: var(--white); border-radius: 20rpx;
  padding: 16rpx 24rpx; margin-bottom: 16rpx;
  box-shadow: var(--shadow);
}
.search-icon { font-size: 28rpx; }
.search-input {
  flex: 1; font-size: 28rpx; color: var(--text);
  background: transparent;
}

/* ── 俱乐部行 ───────────────────────────────────── */
.club-row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 0; border-bottom: 1rpx solid var(--border);
}
.club-row:last-child { border-bottom: none; padding-bottom: 0; }
.club-avatar {
  width: 80rpx; height: 80rpx; border-radius: 20rpx; flex-shrink: 0;
  background: linear-gradient(135deg, #FF6B35 0%, #FFB347 100%);
  display: flex; align-items: center; justify-content: center;
}
.club-avatar-emoji { font-size: 36rpx; }
.club-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.club-name { font-size: 28rpx; font-weight: 600; color: var(--text); }
.club-sub  { font-size: 22rpx; color: var(--text-light); }

/* ── 骨架屏 ─────────────────────────────────────── */
.skeleton-list {
  background: var(--white); border-radius: var(--radius);
  padding: 28rpx; box-shadow: var(--shadow);
}
.skeleton-row {
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 0; border-bottom: 1rpx solid var(--border);
}
.skeleton-row:last-child { border-bottom: none; }
.sk-avatar {
  width: 80rpx; height: 80rpx; border-radius: 20rpx; flex-shrink: 0;
  background: linear-gradient(90deg, #EEF1F8 25%, #E2E6EF 50%, #EEF1F8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}
.sk-avatar-square { border-radius: 20rpx; }
.sk-lines { flex: 1; display: flex; flex-direction: column; gap: 12rpx; }
.sk-line {
  height: 24rpx; border-radius: 6rpx;
  background: linear-gradient(90deg, #EEF1F8 25%, #E2E6EF 50%, #EEF1F8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}
.sk-line-a { width: 50%; }
.sk-line-b { width: 75%; }
.sk-btn {
  width: 96rpx; height: 56rpx; border-radius: 48rpx;
  background: linear-gradient(90deg, #EEF1F8 25%, #E2E6EF 50%, #EEF1F8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}
@keyframes shimmer {
  0%   { background-position: 200% 0 }
  100% { background-position: -200% 0 }
}

/* ── 空状态 ─────────────────────────────────────── */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 80rpx 24rpx; gap: 20rpx;
  background: var(--white); border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.es-icon  { font-size: 72rpx; line-height: 1; }
.es-title { font-size: 32rpx; font-weight: 700; color: var(--text); }
.es-desc  {
  font-size: 26rpx; color: var(--text-light);
  text-align: center; line-height: 1.7; white-space: pre-wrap;
}
.es-btn {
  margin-top: 12rpx;
  background: var(--primary); color: #fff;
  font-size: 28rpx; font-weight: 700;
  border-radius: 48rpx; padding: 18rpx 56rpx; border: none;
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,.32);
}

/* ── 搜索栏创建按钮 ─────────────────────────────── */
.search-create-btn {
  display: flex; align-items: center; gap: 4rpx;
  padding: 8rpx 20rpx; border-radius: 32rpx; flex-shrink: 0;
  background: rgba(255,107,53,.1);
}
.scb-icon { font-size: 30rpx; color: var(--primary); font-weight: 700; line-height: 1; }
.scb-txt  { font-size: 24rpx; color: var(--primary); font-weight: 700; }

/* ── 创建俱乐部弹层 ─────────────────────────────── */
@keyframes ccIn {
  from { opacity: 0; transform: scale(.92); }
  to   { opacity: 1; transform: scale(1); }
}
.cc-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.55); backdrop-filter: blur(6rpx);
  z-index: 2000;
  display: flex; align-items: center; justify-content: center;
  padding: 48rpx;
}
.cc-card {
  width: 100%; max-width: 600rpx;
  background: var(--white); border-radius: 32rpx;
  padding: 40rpx 36rpx 32rpx;
  animation: ccIn .25s cubic-bezier(.34,1.56,.64,1) forwards;
}
.cc-title {
  display: block; text-align: center;
  font-size: 32rpx; font-weight: 800; color: var(--text);
}
.cc-sub {
  display: block; text-align: center;
  font-size: 22rpx; color: var(--text-light);
  margin: 8rpx 0 28rpx;
}
.cc-field { margin-bottom: 24rpx; }
.cc-label {
  display: block; font-size: 24rpx; color: var(--text-mid);
  margin-bottom: 12rpx; font-weight: 600;
}
.cc-required { color: #EF4444; margin-left: 4rpx; }
.cc-opt { color: var(--text-light); font-weight: 400; }
.cc-input {
  width: 100%; height: 80rpx;
  background: #F7F9FC; border-radius: 16rpx;
  padding: 0 24rpx; font-size: 28rpx; color: var(--text);
  box-sizing: border-box;
}
.cc-btns { display: flex; gap: 16rpx; margin-top: 32rpx; }
.cc-btn {
  flex: 1; height: 88rpx; border-radius: 22rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 700;
}
.cc-btn-cancel { background: #F0F2F8; color: var(--text-mid); }
.cc-btn-create {
  background: linear-gradient(135deg, #FF6B35, #FF8F5E); color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,.35);
}
.cc-btn-loading { opacity: .6; }

/* ── 底部安全距离 ───────────────────────────────── */
.bottom-safe { height: calc(100rpx + env(safe-area-inset-bottom) + 32rpx); }
