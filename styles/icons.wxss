/* ════════════════════════════════════════════════════
   Lucide Icons — 全局图标系统
   使用方式：<view class="lc lc-md lc-flame" style="background-color:#FF6B35;"></view>
   ════════════════════════════════════════════════════ */

/* ── 基础：mask-based 可染色图标 ── */
.lc {
  display: block;
  -webkit-mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  flex-shrink: 0;
}

/* ── 尺寸 ── */
.lc-xs  { width: 24rpx; height: 24rpx; }
.lc-sm  { width: 32rpx; height: 32rpx; }
.lc-md  { width: 40rpx; height: 40rpx; }
.lc-lg  { width: 56rpx; height: 56rpx; }
.lc-xl  { width: 72rpx; height: 72rpx; }
.lc-2xl { width: 96rpx; height: 96rpx; }

/* ── 颜色快捷类 ── */
.lc-primary  { background-color: #FF6B35; }
.lc-white    { background-color: #fff; }
.lc-green    { background-color: #10B981; }
.lc-indigo   { background-color: #6366F1; }
.lc-gray     { background-color: #94A3B8; }
.lc-text     { background-color: #1A1A2E; }
.lc-yellow   { background-color: #F59E0B; }
.lc-blue     { background-color: #2563EB; }
.lc-red      { background-color: #EF4444; }

/* ════════════════════════════════════════════════════
   图标定义（全部来自 Lucide Icons，MIT 协议）
   ════════════════════════════════════════════════════ */

